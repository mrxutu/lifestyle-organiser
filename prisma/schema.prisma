// schema.prisma
// Lifestyle Organiser — Postgres schema (Prisma 7)
// Run: npx prisma migrate dev --name merge-reminders-into-events

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- USERS & HOUSEHOLDS ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  role         Role       @default(MEMBER)
  isActive     Boolean    @default(true)
  household    Household? @relation(fields: [householdId], references: [id])
  householdId  String?
  createdAt    DateTime   @default(now())

  eventsCreated        Event[]              @relation("EventCreator")
  eventInvites         EventAttendee[]
  recipesAuthored      Recipe[]             @relation("RecipeAuthor")
  recipesAsChef        Recipe[]             @relation("RecipeChef")
  watchlistAssignments WatchlistViewer[]
  books                Book[]
  passwordResetTokens  PasswordResetToken[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Household {
  id               String            @id @default(cuid())
  name             String
  users            User[]
  events           Event[]
  recipes          Recipe[]
  watchlist        WatchlistEntry[]
  books            Book[]
  eventTypes       EventType[]
  watchlistSources WatchlistSource[]
  bookSources      BookSource[]

  // Admin-controlled section visibility — no per-user preference. Reminders is a
  // filtered view of Events, not a separate model, so it rides along with showCalendar.
  showCalendar  Boolean @default(true)
  showRecipes   Boolean @default(true)
  showWatchlist Boolean @default(true)
  showBooks     Boolean @default(true)
}

// ---------- EVENTS (colour-coded calendar — reminders are events too) ----------

model Event {
  id          String          @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean         @default(false)
  location    String?
  eventType   EventType       @relation(fields: [eventTypeId], references: [id])
  eventTypeId String
  household   Household       @relation(fields: [householdId], references: [id])
  householdId String
  creator     User            @relation("EventCreator", fields: [creatorId], references: [id])
  creatorId   String
  attendees   EventAttendee[]

  // Reminder-style fields — set these to make an event behave as a reminder
  // (e.g. "Car Insurance Renewal"): recurring, with a lead-time "due soon" window.
  // leadTimeDays stays nullable at the DB level (no @default here) — the event
  // FORM should default the input to 0 (opt-out design: new events show on the
  // Reminders page unless this is manually cleared to null, e.g. for "Weekend Away").
  recurrence          Recurrence @default(NONE)
  leadTimeDays        Int? // null = excluded from Reminders page; 0+ = included, due-soon window in days
  remindMinutesBefore Int? // for same-day nudges on regular events, if ever needed

  createdAt DateTime @default(now())
}

enum Recurrence {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

model EventType {
  id          String    @id @default(cuid())
  name        String // e.g. "Weekend Away", "Appointment", "Insurance", "Bill"
  color       String // hex code — drives calendar colour-coding
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  events      Event[]

  @@unique([householdId, name])
}

model EventAttendee {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String

  @@unique([eventId, userId])
}

// ---------- RECIPES ----------

model Recipe {
  id          String       @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  servings    Int?
  prepMinutes Int?
  cookMinutes Int?
  tags        String[]
  ingredients Ingredient[]
  method      String? // single multi-line text field, pasted in — not a repeatable Step model
  household   Household    @relation(fields: [householdId], references: [id])
  householdId String
  author      User         @relation("RecipeAuthor", fields: [authorId], references: [id])
  authorId    String
  chef        User         @relation("RecipeChef", fields: [chefId], references: [id])
  chefId      String
  createdAt   DateTime     @default(now())
}

model Ingredient {
  id       String           @id @default(cuid())
  recipe   Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  name     String // e.g. "Sugar", "Lemon", "Milk"
  amount   Float? // supports decimals, e.g. 1.5 — null if the ingredient has no quantity (rare)
  unit     MeasurementUnit? // null = no unit, e.g. "1 lemon" rather than "1 whole lemon"
  order    Int              @default(0)
}

enum MeasurementUnit {
  TSP
  TBSP
  G
  ML
  LITRE
  PINT
  OZ
  LB
}

// ---------- WATCHLIST ----------

model WatchlistEntry {
  id          String            @id @default(cuid())
  name        String // show/movie title
  source      WatchlistSource   @relation(fields: [sourceId], references: [id])
  sourceId    String
  season      Int? // nullable — movies/one-offs may not have a season
  episode     Int?
  status      WatchStatus       @default(TO_WATCH)
  rating      Int? // 1-5 stars, null = not rated
  household   Household         @relation(fields: [householdId], references: [id])
  householdId String
  viewers     WatchlistViewer[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt // auto-updates whenever any field on the row changes
}

model WatchlistViewer {
  id               String         @id @default(cuid())
  watchlistEntry   WatchlistEntry @relation(fields: [watchlistEntryId], references: [id], onDelete: Cascade)
  watchlistEntryId String
  user             User           @relation(fields: [userId], references: [id])
  userId           String

  @@unique([watchlistEntryId, userId])
}

enum WatchStatus {
  TO_WATCH
  WATCHING
  WATCHED
}

model WatchlistSource {
  id          String           @id @default(cuid())
  name        String // e.g. "Netflix", "Apple TV", "IP Stream", "Prime", "Terrestrial"
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  entries     WatchlistEntry[]

  @@unique([householdId, name])
}

// ---------- BOOKS ----------

model Book {
  id          String     @id @default(cuid())
  title       String
  author      String
  summary     String?
  imageUrl    String?
  dateRead    DateTime?
  rating      Int? // 1-5 stars, null = not rated
  status      BookStatus @default(TO_READ)
  source      BookSource @relation(fields: [sourceId], references: [id])
  sourceId    String
  notes       String?
  reader      User       @relation(fields: [readerId], references: [id])
  readerId    String
  household   Household  @relation(fields: [householdId], references: [id])
  householdId String
  createdAt   DateTime   @default(now())
}

enum BookStatus {
  TO_READ
  READING
  READ
}

model BookSource {
  id          String    @id @default(cuid())
  name        String // e.g. "Kindle", "Physical Book", "Audiobook", "Library"
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  books       Book[]

  @@unique([householdId, name])
}
